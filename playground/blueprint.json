{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Storylane RepX plugin preview",
    "description": "WordPress with the Storylane RepX plugin installed and RepX switched on.",
    "author": "Storylane"
  },
  "landingPage": "/wp-admin/options-general.php?page=storylane-repx",
  "preferredVersions": { "php": "8.3", "wp": "latest" },
  "steps": [
    { "step": "login" },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "git:directory",
        "url": "https://github.com/sharvan-story/storylane-repx",
        "ref": "main",
        "refType": "branch",
        "path": "storylane-repx"
      },
      "options": { "activate": true }
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; update_option( 'storylane_repx_settings', array( 'id' => 'mbtx79fn0yum', 'enabled' => 1 ) );"
    }
  ]
}
